# ASTROHEALTH: AI-Powered Astronaut Health Monitoring System
# Configuration Environment Variables

# Application
APP_NAME=AstroHealth
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & JWT
JWT_SECRET_KEY=astrohealth-deep-space-secret-key-super-secure-change-in-prod-9847238472
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=astrohealth_db
OFFLINE_SQLITE_PATH=astrohealth_offline_buffer.db

# MQTT Hardware Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_TOPIC_PREFIX=astrohealth/
MQTT_CLIENT_ID=astrohealth_backend_service

# Hardware Simulation
SIMULATION_MODE=True
SIMULATION_INTERVAL_SECONDS=2.0

# AI Configuration
ANOMALY_CONTAMINATION=0.08
SHAP_BACKGROUND_SAMPLES=50
FORECAST_HORIZON_STEPS=12

