# ==============================================================================
# AstroHealth - Aerospace Medical Monitoring System .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Testing & Code Analysis
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & React Frontend (Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Secrets & Environment Configurations
# ------------------------------------------------------------------------------
# Ignore all .env files containing production credentials / API secrets
.env
.env.*
# Keep example templates committed
!.env.example

# Credentials & TLS Keys
*.pem
*.key
*.cert
*.crt
id_rsa
id_ecdsa
id_ed25519

# ------------------------------------------------------------------------------
# Databases & Local Offline Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
astrohealth_offline_buffer.db

# ------------------------------------------------------------------------------
# AI Engine & Serialized Model Caches
# ------------------------------------------------------------------------------
.cache/
*.joblib
*.pkl

# ------------------------------------------------------------------------------
# Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# IDE, Editor & OS Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

